# Copia in .env.cloudflare.local. Nessuna di queste variabili va nel frontend.
CLOUDFLARE_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STAGING_BUCKET=unseen-uploads
R2_PUBLIC_BUCKET=unseen-media
R2_PUBLIC_URL=
CLOUDFLARE_API_TOKEN=
MEDIA_ALLOWED_ORIGINS=https://unseen-virid.vercel.app,http://localhost:8080,http://127.0.0.1:8080
